{
	"name": "allez.gamebus.eu",
	"version": "0.0.1",
	"private": true,
	"packageManager": "npm@10.9.3",
	"engines": {
		"node": ">=22.18.0"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"assets": "node scripts/assets.mjs",
		"prebuild": "npm run assets",
		"predev": "npm run assets",
		"test:providers": "node scripts/check-providers.mjs",
		"test:unit": "node --experimental-strip-types --experimental-test-module-mocks --test tests/workout.test.ts scripts/motion.test.mjs scripts/camera.test.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "node scripts/serve-static.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "bddgen && playwright test",
		"test": "npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "latest",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.82.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22",
		"bits-ui": "^2.22.0",
		"cn": "^0.5.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright-bdd": "^9.2.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-dnd-action": "^0.9.81",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "0.10.32",
		"@tensorflow/tfjs-backend-cpu": "4.22.0",
		"@tensorflow/tfjs-backend-webgl": "4.22.0",
		"@tensorflow/tfjs-converter": "4.22.0",
		"@tensorflow/tfjs-core": "4.22.0"
	}
}
